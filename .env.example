# Cloud credentials are optional; local demo needs none.
SAAS_TARGET=local
SAAS_ROOT=/opt/project
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=SAAS_TRANSFORMER
SNOWFLAKE_WAREHOUSE=SAAS_ETL_WH
SNOWFLAKE_DATABASE=SAAS_ANALYTICS
SNOWFLAKE_SCHEMA=ANALYTICS
S3_BUCKET=
# Provision this external stage with warehouse/bootstrap.sql first.
SNOWFLAKE_STAGE=SAAS_ANALYTICS.RAW.SAAS_LANDING
AWS_DEFAULT_REGION=us-east-1
