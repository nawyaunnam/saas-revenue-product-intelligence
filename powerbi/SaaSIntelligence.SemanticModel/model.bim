    "expressions": [
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:\\saas-intelligence\\artifacts\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "UseSnowflake",
        "kind": "m",
        "expression": "false meta [IsParameterQuery=true, Type=\"Logical\", IsParameterQueryRequired=true]"
      },
      {
        "name": "SnowflakeServer",
        "kind": "m",
        "expression": "\"YOUR_ACCOUNT.snowflakecomputing.com\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "SnowflakeWarehouse",
        "kind": "m",
        "expression": "\"SAAS_ETL_WH\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "SnowflakeDatabase",
        "kind": "m",
        "expression": "\"SAAS_ANALYTICS\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "RangeStart",
        "kind": "m",
        "expression": "#datetime(2024, 1, 1, 0, 0, 0) meta [IsParameterQuery=true, Type=\"DateTime\", IsParameterQueryRequired=true]"
      },
      {
        "name": "RangeEnd",
        "kind": "m",
        "expression": "#datetime(2025, 7, 1, 0, 0, 0) meta [IsParameterQuery=true, Type=\"DateTime\", IsParameterQueryRequired=true]"
      },
      {
        "name": "LoadMart",
        "kind": "m",
        "expression": "(tableName as text) as table =>\nlet\n    Source = if UseSnowflake then\n        let\n            Connection = Snowflake.Databases(SnowflakeServer, SnowflakeWarehouse, [Implementation=\"2.0\", Role=\"SAAS_BI_READER\"]),\n            Database = Connection{[Name=SnowflakeDatabase, Kind=\"Database\"]}[Data],\n            Schema = Database{[Name=\"ANALYTICS\", Kind=\"Schema\"]}[Data],\n            WarehouseTable = Schema{[Name=Text.Upper(tableName), Kind=\"Table\"]}[Data]\n        in Table.TransformColumnNames(WarehouseTable, Text.Lower)\n    else Table.PromoteHeaders(Csv.Document(File.Contents(DataFolder & \"/\" & tableName & \".csv\"),\n         [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true])\nin Source"
      }
    ],
    "roles": [
      {
        "name": "Regional Analyst",
        "modelPermission": "read",
        "tablePermissions": [
          {
            "name": "Account",
            "filterExpression": "CONTAINS(FILTER(UserRegion, UserRegion[upn] = USERPRINCIPALNAME()), UserRegion[region], Account[region])"
          },
          {
            "name": "UserRegion",
            "filterExpression": "UserRegion[upn] = USERPRINCIPALNAME()"
          },
          {
            "name": "Marketing",
            "filterExpression": "FALSE()"
          }
        ]
      }
    ]
  }
}
