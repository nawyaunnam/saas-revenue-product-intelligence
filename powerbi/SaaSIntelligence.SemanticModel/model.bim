      {
        "name": "Metrics",
        "lineageTag": "0dede94a-3b68-5ad3-82f7-c8037d75cd2c",
        "columns": [
          {
            "name": "Value",
            "dataType": "int64",
            "sourceColumn": "Value",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Metrics",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [Value=Int64.Type], {{1}})"
            }
          }
        ],
        "measures": [
          {
            "name": "MRR",
            "expression": "VAR Period = MAX(Revenue[month]) RETURN CALCULATE(SUM(Revenue[mrr]), KEEPFILTERS(Revenue[month] = Period))",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "Revenue",
            "lineageTag": "646031e1-eace-5cce-bee9-3f0fbc0368fa"
          },
          {
            "name": "Beginning MRR",
            "expression": "VAR Period = MAX(Revenue[month]) RETURN CALCULATE(SUM(Revenue[beginning_mrr]), KEEPFILTERS(Revenue[month] = Period))",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "Revenue",
            "lineageTag": "f207f287-5e4b-507e-83e4-e478769ecf12"
          },
          {
            "name": "New MRR",
            "expression": "VAR Period = MAX(Revenue[month]) RETURN CALCULATE(SUM(Revenue[new_mrr]), KEEPFILTERS(Revenue[month] = Period))",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "Revenue",
            "lineageTag": "ee4753b5-cc2b-57d6-b63e-5a75e95bfe87"
          },
          {
            "name": "Reactivation MRR",
            "expression": "VAR Period = MAX(Revenue[month]) RETURN CALCULATE(SUM(Revenue[reactivation_mrr]), KEEPFILTERS(Revenue[month] = Period))",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "Revenue",
            "lineageTag": "45a94350-5258-5983-a8fe-907b05b470a3"
          },
          {
            "name": "Expansion MRR",
            "expression": "VAR Period = MAX(Revenue[month]) RETURN CALCULATE(SUM(Revenue[expansion_mrr]), KEEPFILTERS(Revenue[month] = Period))",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "Revenue",
            "lineageTag": "d47cd1ca-7bd1-58f9-b635-e23abdba9ae7"
          },
          {
            "name": "Contraction MRR",
            "expression": "VAR Period = MAX(Revenue[month]) RETURN CALCULATE(SUM(Revenue[contraction_mrr]), KEEPFILTERS(Revenue[month] = Period))",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "Revenue",
            "lineageTag": "93364138-2d24-54b0-ad6d-ffda48cf9635"
          },
          {
            "name": "Churn MRR",
            "expression": "VAR Period = MAX(Revenue[month]) RETURN CALCULATE(SUM(Revenue[churn_mrr]), KEEPFILTERS(Revenue[month] = Period))",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "Revenue",
            "lineageTag": "96b8eb77-bc93-5bfe-9c5b-baa644db6b0c"
          },
          {
            "name": "Paying accounts",
            "expression": "VAR Period = MAX(Revenue[month]) RETURN CALCULATE(SUM(Revenue[paying_account]), KEEPFILTERS(Revenue[month] = Period))",
            "formatString": "#,0",
            "displayFolder": "Revenue",
            "lineageTag": "1ff6b5ec-d0ee-5bc4-84a3-c8f996e1041f"
          },
          {
            "name": "Beginning accounts",
            "expression": "VAR Period = MAX(Revenue[month]) RETURN CALCULATE(SUM(Revenue[beginning_account]), KEEPFILTERS(Revenue[month] = Period))",
            "formatString": "#,0",
            "displayFolder": "Revenue",
            "lineageTag": "2ed0b6ed-4434-5627-b1a9-f4c88f234a3f"
          },
          {
            "name": "Churned accounts",
            "expression": "VAR Period = MAX(Revenue[month]) RETURN CALCULATE(SUM(Revenue[churned_account]), KEEPFILTERS(Revenue[month] = Period))",
            "formatString": "#,0",
            "displayFolder": "Revenue",
            "lineageTag": "d225cfd7-bd92-5542-9af6-08a2a1001ac4"
          },
          {
            "name": "ARR",
            "expression": "[MRR] * 12",
            "formatString": "$#,0",
            "displayFolder": "Revenue",
            "lineageTag": "1e2ccab5-24bd-503d-90b1-70748592b56a"
          },
          {
            "name": "NRR",
            "expression": "DIVIDE([Beginning MRR] + [Expansion MRR] - [Contraction MRR] - [Churn MRR], [Beginning MRR])",
            "formatString": "0.0%",
            "displayFolder": "Revenue",
            "lineageTag": "87c9b473-3180-5a9f-9c07-6a1588f62604"
          },
          {
            "name": "GRR",
            "expression": "DIVIDE([Beginning MRR] - [Contraction MRR] - [Churn MRR], [Beginning MRR])",
            "formatString": "0.0%",
            "displayFolder": "Revenue",
            "lineageTag": "5328df88-3c3a-52cd-ba90-4589075c4dd8"
          },
          {
            "name": "Logo churn",
            "expression": "DIVIDE([Churned accounts], [Beginning accounts])",
            "formatString": "0.0%",
            "displayFolder": "Revenue",
            "lineageTag": "3ecd3d88-2b67-5aeb-b651-cb107d30e1fc"
          },
          {
            "name": "ARPA",
            "expression": "DIVIDE([MRR], [Paying accounts])",
            "formatString": "$#,0",
            "displayFolder": "Revenue",
            "lineageTag": "0c0bb5f0-d883-5d6a-ad4d-afa47ffbae04"
          },
          {
            "name": "Modeled LTV",
            "expression": "VAR Period = MAX(Revenue[month])\nVAR WindowDates = DATESBETWEEN('Date'[date_day], EDATE(Period, -2), EOMONTH(Period, 0))\nVAR Churned = CALCULATE(SUM(Revenue[churned_account]), REMOVEFILTERS('Date'), WindowDates)\nVAR Starting = CALCULATE(SUM(Revenue[beginning_account]), REMOVEFILTERS('Date'), WindowDates)\nRETURN DIVIDE([ARPA] * 0.8, DIVIDE(Churned, Starting))",
            "formatString": "$#,0",
            "displayFolder": "Revenue",
            "lineageTag": "ab11867e-1c15-52ff-9e3c-c36d3596f990"
          },
          {
            "name": "MRR reconciliation",
            "expression": "[MRR] - ([Beginning MRR] + [New MRR] + [Reactivation MRR] + [Expansion MRR] - [Contraction MRR] - [Churn MRR])",
            "formatString": "$#,0.00",
            "displayFolder": "Revenue",
            "lineageTag": "137c3bde-8dda-51df-b231-ae7678a2acf4"
          },
          {
            "name": "Active users",
            "expression": "DISTINCTCOUNT(Events[user_id])",
            "formatString": "#,0",
            "displayFolder": "Product",
            "lineageTag": "3a9009a3-71b6-5b7a-8498-b8fd25f9e73f"
          },
          {
            "name": "MAU",
            "expression": "VAR LastDate = MAX('Date'[date_day])\nRETURN CALCULATE([Active users], REMOVEFILTERS('Date'), DATESBETWEEN('Date'[date_day], DATE(YEAR(LastDate), MONTH(LastDate), 1), EOMONTH(LastDate, 0)))",
            "formatString": "#,0",
            "displayFolder": "Product",
            "lineageTag": "9cf6c6fe-bc41-5379-95e4-81a5b4f9f0f1"
          },
          {
            "name": "Average DAU",
            "expression": "VAR LastDate = MAX('Date'[date_day])\nVAR DaysInMonth = CALCULATETABLE(VALUES('Date'[date_day]), REMOVEFILTERS('Date'), DATESBETWEEN('Date'[date_day], DATE(YEAR(LastDate),MONTH(LastDate),1), EOMONTH(LastDate,0)))\nRETURN AVERAGEX(DaysInMonth, COALESCE(CALCULATE([Active users]),0))",
            "formatString": "#,0.0",
            "displayFolder": "Product",
            "lineageTag": "4686354e-4978-55f4-a97b-3a6c93e30cda"
          },
          {
            "name": "Stickiness",
            "expression": "DIVIDE([Average DAU],[MAU])",
            "formatString": "0.0%",
            "displayFolder": "Product",
            "lineageTag": "ff743e3f-13b1-5c85-b510-a3397240bbe6"
          },
          {
            "name": "Feature adoption",
            "expression": "DIVIDE([MAU], CALCULATE([MAU], REMOVEFILTERS(Events[event_name])))",
            "formatString": "0.0%",
            "displayFolder": "Product",
            "lineageTag": "92709581-a6fe-594c-978f-cfe03aaac925"
          },
          {
            "name": "Signup accounts",
            "expression": "COUNTROWS(Funnel)",
            "formatString": "#,0",
            "displayFolder": "Acquisition",
            "lineageTag": "7ba49140-2db8-555d-9a95-76007f63a300"
          },
          {
            "name": "Qualified accounts",
            "expression": "SUM(Funnel[qualified])",
            "formatString": "#,0",
            "displayFolder": "Acquisition",
            "lineageTag": "0b619538-7a88-5984-80d7-8ef0513e0626"
          },
          {
            "name": "Converted accounts",
            "expression": "SUM(Funnel[converted])",
            "formatString": "#,0",
            "displayFolder": "Acquisition",
            "lineageTag": "21e61b96-b2bd-502e-8c71-c1c9911531f5"
          },
          {
            "name": "Conversion rate",
            "expression": "DIVIDE([Converted accounts], [Signup accounts])",
            "formatString": "0.0%",
            "displayFolder": "Acquisition",
            "lineageTag": "01c73b4b-6f40-5b4b-aaff-50b60bf10b24"
          },
          {
            "name": "Activation rate",
            "expression": "DIVIDE(CALCULATE(SUM(Funnel[activated]), Funnel[activation_eligible]=1), SUM(Funnel[activation_eligible]))",
            "formatString": "0.0%",
            "displayFolder": "Acquisition",
            "lineageTag": "1130a9a7-9e81-5ac4-b3ca-e0967f8b292b"
          },
          {
            "name": "Marketing spend",
            "expression": "CALCULATE(SUM(Marketing[spend]), TREATAS(VALUES(Account[channel]), Marketing[channel]))",
            "formatString": "$#,0",
            "displayFolder": "Acquisition",
            "lineageTag": "41917845-2bd0-5295-abc4-b5cc02bc0dfa"
          },
          {
            "name": "Cohort acquisition cost",
            "expression": "DIVIDE([Marketing spend],[Converted accounts])",
            "formatString": "$#,0",
            "displayFolder": "Acquisition",
            "lineageTag": "a4e11a4a-4a91-5e75-803d-ca2de94bdee7"
          },
          {
            "name": "Retained accounts",
            "expression": "DISTINCTCOUNT(Events[account_id])",
            "formatString": "#,0",
            "displayFolder": "Retention",
            "lineageTag": "b3ef4434-b8ab-502f-9d76-4df0fb518f3a"
          },
          {
            "name": "Cohort accounts",
            "expression": "COUNTROWS(Account)",
            "formatString": "#,0",
            "displayFolder": "Retention",
            "lineageTag": "2652c8a7-7988-53e7-aee5-38647bd0b3fd"
          },
          {
            "name": "Cohort retention",
            "expression": "DIVIDE([Retained accounts],[Cohort accounts])",
            "formatString": "0.0%",
            "displayFolder": "Retention",
            "lineageTag": "a5a35c0a-3923-50b1-9bd9-75666b787b61"
          },
          {
            "name": "Account context",
            "expression": "SELECTEDVALUE(Account[account_id], \"Multiple accounts\")",
            "formatString": "",
            "displayFolder": "Tooltips",
            "lineageTag": "84e8b48a-bcdf-5bdc-9c98-88c571d61282"
          },
          {
            "name": "Revenue context",
            "expression": "\"MRR \" & FORMAT([MRR], \"$#,0\") & \" | NRR \" & FORMAT([NRR], \"0.0%\")",
            "formatString": "",
            "displayFolder": "Tooltips",
            "lineageTag": "077bce79-65c1-54f2-b459-04632475b49d"
          }
        ]
      },
      {
        "name": "UserRegion",
        "isHidden": true,
        "columns": [
          {
            "name": "upn",
            "dataType": "string",
            "sourceColumn": "upn"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region"
          }
        ],
        "partitions": [
          {
            "name": "UserRegion",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [upn=text, region=text], {{\"amer.analyst@example.com\",\"AMER\"},{\"emea.analyst@example.com\",\"EMEA\"},{\"apac.analyst@example.com\",\"APAC\"}})"
            }
          }
        ]
      },
      {
        "name": "Period comparison",
        "columns": [
          {
            "name": "Period",
            "dataType": "string",
            "sourceColumn": "Name"
          }
        ],
        "partitions": [
          {
            "name": "Period comparison",
            "mode": "import",
            "source": {
              "type": "calculationGroup"
            }
          }
        ],
        "calculationGroup": {
          "precedence": 10,
          "calculationItems": [
            {
              "name": "Current",
              "expression": "SELECTEDMEASURE()",
              "ordinal": 0
            },
            {
              "name": "Previous month",
              "expression": "CALCULATE(SELECTEDMEASURE(), DATEADD('Date'[date_day], -1, MONTH))",
              "ordinal": 1
            },
            {
              "name": "MoM change %",
              "expression": "VAR Prior = CALCULATE(SELECTEDMEASURE(), DATEADD('Date'[date_day], -1, MONTH)) RETURN DIVIDE(SELECTEDMEASURE() - Prior, Prior)",
              "ordinal": 2,
              "formatStringDefinition": {
                "expression": "\"0.0%;-0.0%;0.0%\""
              }
            }
          ]
        }
      },
      {
        "name": "Metric selector",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Metric",
            "dataType": "string",
            "sourceColumn": "[Value1]",
            "sortByColumn": "Order",
            "relatedColumnDetails": {
              "groupByColumns": [
                {
                  "groupingColumn": "Fields"
                }
              ]
            }
          },
          {
            "type": "calculatedTableColumn",
            "name": "Fields",
            "dataType": "string",
            "sourceColumn": "[Value2]",
            "isHidden": true,
            "sortByColumn": "Order",
            "extendedProperties": [
              {
                "type": "json",
                "name": "ParameterMetadata",
                "value": {
                  "version": 3,
                  "kind": 2
                }
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Order",
            "dataType": "int64",
            "sourceColumn": "[Value3]",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Metric selector",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "{(\"MRR\", NAMEOF(Metrics[MRR]), 0), (\"ARR\", NAMEOF(Metrics[ARR]), 1), (\"NRR\", NAMEOF(Metrics[NRR]), 2), (\"MAU\", NAMEOF(Metrics[MAU]), 3)}"
            }
          }
        ]
      }
    ],
