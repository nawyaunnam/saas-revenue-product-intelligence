{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "revenue_trend",
  "position": {
    "x": 20,
    "y": 170,
    "z": 0,
    "height": 300,
    "width": 800,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "month"
                }
              },
              "queryRef": "0Category",
              "nativeQueryRef": "month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Metrics"
                    }
                  },
                  "Property": "MRR"
                }
              },
              "queryRef": "0Y",
              "nativeQueryRef": "MRR"
            }
          ],
          "fieldParameters": [
            {
              "parameterExpr": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Metric selector"
                    }
                  },
                  "Property": "Metric"
                }
              },
              "index": 0,
              "length": 1
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly recurring revenue'"
                }
              }
            }
          }
        }
      ],
      "visualTooltip": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "type": {
              "expr": {
                "Literal": {
                  "Value": "'ReportPage'"
                }
              }
            },
            "section": {
              "expr": {
                "Literal": {
                  "Value": "'revenue_tooltip'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
